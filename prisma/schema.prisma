generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Users {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  username          String        @unique
  passwordHash      String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@map("users")
}

model Chats {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  userId            String        @db.ObjectId
  userMessage       String
  botResponse       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@map("chats")
}
